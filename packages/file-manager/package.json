{
  "name": "anything-file-manager",
  "version": "1.0.0",
  "description": "Anything File Manager — High-performance Media & Production File Explorer",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:nopack": "electron-vite build"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-vite": "^2.0.0",
    "electron-builder": "^24.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "lucide-react": "^0.400.0"
  },
  "build": {
    "appId": "com.anything.filemanager",
    "productName": "Anything File Manager",
    "directories": { "output": "dist-installer" },
    "win": {
      "target": "dir",
      "executableName": "UniFileManager"
    }
  }
}
