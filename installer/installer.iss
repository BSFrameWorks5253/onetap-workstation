; Uni Desk Professional Setup Script
; Script generated by Antigravity AI for BS Framework

[Setup]
AppId={{com.bsframework.onetap}}
AppName=Uni Desk
AppVersion=26.10.13
AppPublisher=BS Framework
AppPublisherURL=https://bsframework.com/
DefaultDirName={autopf}\Uni Desk
DefaultGroupName=Uni Desk
AllowNoIcons=yes
; Professional Installer Assets
SetupIconFile=..\resources\icon.ico
LicenseFile=..\resources\LICENSE.txt
WizardImageFile=..\resources\installer_banner.png
WizardSmallImageFile=..\resources\installer_small.png
Compression=lzma
SolidCompression=yes
WizardStyle=modern
OutputDir=..\release
OutputBaseFilename=UniDesk_V26.10.13_Setup
PrivilegesRequired=lowest
SetupMutex=UniDesk_Setup_Mutex
AppMutex=UniDesk_App_Mutex


[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "fileassoc"; Description: "Register Uni Desk as default viewer for images, videos, PDFs and documents"; GroupDescription: "File Associations:"; Flags: unchecked

[Files]
; This points to the folder created by 'npm run build:win'
Source: "..\release\win-unpacked\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\packages\file-manager\dist-installer\win-unpacked\*"; DestDir: "{app}\FileManager"; Flags: recursesubdirs ignoreversion skipifsourcedoesntexist; Check: DirExists(ExpandConstant('{src}\..\packages\file-manager\dist-installer\win-unpacked'))

[Icons]
Name: "{group}\Uni Desk"; Filename: "{app}\Uni Desk.exe"
Name: "{group}\Uni File Manager"; Filename: "{app}\FileManager\UniFileManager.exe"; IconFilename: "{app}\FileManager\UniFileManager.exe"
Name: "{autodesktop}\Uni Desk"; Filename: "{app}\Uni Desk.exe"; Tasks: desktopicon

