{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd safar-tracker-web && npm install && npm run build",
  "outputDirectory": "safar-tracker-web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
